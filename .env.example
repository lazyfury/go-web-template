# 复制为 .env 后按需修改。所有变量均以 APP_ 为前缀，优先级高于 configs/config.yaml。
# 生产环境请通过密钥管理系统注入环境变量，不要提交 .env。
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

APP_DATABASE_HOST=127.0.0.1
APP_DATABASE_PORT=5432
APP_DATABASE_USER=postgres
APP_DATABASE_PASSWORD=postgres
APP_DATABASE_DBNAME=go_web_template
APP_DATABASE_SSLMODE=disable

APP_LOG_LEVEL=info
APP_LOG_FORMAT=json

# 以下为可选调优项（默认值即可跑通，完整键见 configs/config.example.yaml）
# APP_HTTP_REQUEST_TIMEOUT=15s
# header 阶段超时（防 slowloris，上限 = APP_HTTP_READ_TIMEOUT）
# APP_HTTP_READ_HEADER_TIMEOUT=5s
# APP_HTTP_MAX_BODY_BYTES=1048576
# 请求头上限（stdlib 默认 1 MiB）；反向代理注入很多头时再调大
# APP_HTTP_MAX_HEADER_BYTES=16384
# 可信反向代理（逗号分隔的 IP/CIDR）；不设 = 不信任任何代理，X-Forwarded-For 被忽略
# APP_HTTP_TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16
# APP_RATELIMIT_RPS=100
# APP_RATELIMIT_BURST=200
# 多副本必须共享限流桶：backend=redis + APP_REDIS_ADDR（单实例保持 memory）
# APP_RATELIMIT_BACKEND=redis
# APP_REDIS_ADDR=127.0.0.1:6379
# JWT 签名密钥：>=32 字节；生产必须用密钥管理注入，不要提交真实值
# APP_AUTH_JWT_SECRET=replace-with-a-random-32-plus-byte-secret
# 密钥轮换：新密钥走 JWT_SECRET、旧密钥放 RETIRED_SECRETS（只验不签，逗号分隔），
# kid 标在新签发的 token 头里，便于排查是哪把密钥签的。
# APP_AUTH_JWT_KEY_ID=k2
# APP_AUTH_JWT_RETIRED_SECRETS=previous-secret-at-least-32-bytes-long
# 本地 http 调试置 false（浏览器才会保存 HttpOnly refresh cookie）
# APP_AUTH_COOKIE_SECURE=false
# 文件存储：local = 本地磁盘（默认），s3 = 任意 S3 兼容端点（MinIO/OSS/R2）
# APP_STORAGE_DRIVER=local
# APP_STORAGE_MAX_UPLOAD_BYTES=10485760
# 本地驱动目录与签名下载 URL 的绝对前缀（必须是浏览器可达的 origin）
# APP_STORAGE_LOCAL_ROOT=.local/uploads
# APP_STORAGE_LOCAL_BASE_URL=http://localhost:8080
# 本地下载 URL 的 HMAC 密钥：>=32 字节；生产必须注入，否则启动失败
# APP_STORAGE_SIGNING_SECRET=replace-with-a-random-32-plus-byte-secret
# 长期公开资产链接（/a/{token}）：base_url 填 CDN/反代 origin，cache_ttl 即撤销最坏延迟
# APP_STORAGE_ASSETS_BASE_URL=https://cdn.example.com
# APP_STORAGE_ASSETS_CACHE_TTL=24h
# 上传保护：按用户限流 + 24h 配额（0 = 不限）
# APP_STORAGE_UPLOAD_RPS=2
# APP_STORAGE_UPLOAD_BURST=10
# APP_STORAGE_UPLOAD_DAILY_FILES=200
# APP_STORAGE_UPLOAD_DAILY_BYTES=104857600
# S3 兼容后端（OSS 走 S3 协议）：
# APP_STORAGE_S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# APP_STORAGE_S3_REGION=cn-hangzhou
# APP_STORAGE_S3_BUCKET=my-bucket
# APP_STORAGE_S3_USE_PATH_STYLE=false
# 认证校验缓存：本进程写（改密/改角色/禁用/删除）立即失效，多副本最多滞后一个 TTL；0=关闭
# APP_AUTH_VERIFY_CACHE_TTL=5s
# 滑动续期 30 天 + 会话绝对上限 90 天 + 30s 轮换宽限期
# APP_AUTH_REFRESH_TTL=720h
# APP_AUTH_REFRESH_MAX_LIFETIME=2160h
# APP_AUTH_REFRESH_REUSE_INTERVAL=30s
# 仅 cmd/admin / make seed-admin 与 cmd/seeding 使用（本地测试密码）
# APP_SEED_PASSWORD=admin-password
# APP_CORS_ALLOWED_ORIGINS=https://app.example.com
# APP_SWAGGER_ENABLED=true
# Prometheus 抓取端点；公网部署建议 false
# APP_METRICS_ENABLED=false
# OpenTelemetry 追踪（默认关闭；make observability-up 会自动指向 Tempo）
# APP_OTEL_ENABLED=true
# APP_OTEL_ENDPOINT=127.0.0.1:4317
# APP_OTEL_INSECURE=true
# APP_OTEL_SAMPLE_RATIO=0.1
