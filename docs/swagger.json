        "github_com_example_go-web-template_internal_platform_httpx.Body": {
            "type": "object",
            "properties": {
                "code": {
                    "$ref": "#/definitions/github_com_example_go-web-template_internal_platform_apperr.Code"
                },
                "data": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "internal_user.CreateRequest": {
            "type": "object",
            "required": [
                "email",
                "name"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 2
                }
            }
        },
        "internal_user.UpdateRequest": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "maxLength": 255
                },
                "name": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 2
                }
            }
        }
    }
}