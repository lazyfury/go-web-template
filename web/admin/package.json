{
  "name": "go-web-template-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Admin frontend for go-web-template (Vue 3 + TS + Vite + Element Plus + UnoCSS)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../docs/openapi.json -o src/types/openapi.ts",
    "api:check": "pnpm gen:api && git diff --exit-code -- src/types/openapi.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.9",
    "echarts": "^5.6.0",
    "element-plus": "^2.13.3",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/ep": "^1.2.4",
    "@types/node": "^22.13.0",
    "@unocss/reset": "^66.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "unocss": "^66.0.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^2.2.8"
  },
  "packageManager": "pnpm@11.21.0"
}
